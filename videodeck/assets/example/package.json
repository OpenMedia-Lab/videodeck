{
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.198"
  },
  "name": "videodeck-hyperframes-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local deterministic weighted-expert mechanism example",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "hf": "node scripts/hyperframes.mjs",
    "lint": "node scripts/hyperframes.mjs lint",
    "check": "node scripts/hyperframes.mjs check --samples 15 --at-transitions",
    "snapshot": "node scripts/hyperframes.mjs snapshot --at 1,2.2,3.2,5.8,7.7,8,8.3,8.6,9,10.5 --describe false",
    "render": "node scripts/hyperframes.mjs render --output renders/expert-routing.mp4 --fps 30 --quality standard --workers 1 --no-best-effort",
    "dev": "node scripts/hyperframes.mjs preview",
    "verify:seek": "node scripts/verify-seek.mjs",
    "verify:audio": "node scripts/verify-audio.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "25.16.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
